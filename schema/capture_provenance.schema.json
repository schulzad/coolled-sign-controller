{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "BLE capture provenance",
  "type": "object",
  "required": ["capture_id", "panel_id", "scenario", "capture_source", "test_variables"],
  "properties": {
    "capture_id": {"type": "string", "minLength": 1},
    "panel_id": {"type": "string", "minLength": 1},
    "scenario": {"type": "string", "minLength": 1},
    "capture_source": {"type": "string", "minLength": 1},
    "application": {"type": "object"},
    "test_variables": {"type": "object"},
    "started_at": {"type": ["string", "null"]},
    "ended_at": {"type": ["string", "null"]},
    "sha256": {"type": ["string", "null"]},
    "notes": {"type": "array", "items": {"type": "string"}}
  },
  "additionalProperties": true
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://opensign.local/schema/frame_bundle.schema.json",
  "title": "OpenSign frame bundle",
  "type": "object",
  "required": [
    "schema_version",
    "width",
    "height",
    "color_mode",
    "frame_encoding",
    "frames",
    "frame_hashes",
    "frame_durations_ms",
    "loop_mode",
    "codec_hint",
    "metadata"
  ],
  "properties": {
    "schema_version": {"type": "string"},
    "width": {"type": "integer", "minimum": 1},
    "height": {"type": "integer", "minimum": 1},
    "color_mode": {"type": "string"},
    "frame_encoding": {"const": "base64"},
    "frames": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "frame_hashes": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "frame_durations_ms": {"type": "array", "minItems": 1, "items": {"type": "integer", "minimum": 1}},
    "frames_per_second": {"type": ["number", "null"], "exclusiveMinimum": 0},
    "loop_mode": {"enum": ["once", "loop", "ping_pong"]},
    "codec_hint": {"type": "string"},
    "metadata": {"type": "object"}
  },
  "additionalProperties": true
}
